# ── Server ──────────────────────────────────────────────────
# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/winter-arc?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret

# Port the Express server listens on
PORT=5000

# Allowed client origin for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# OTP provider:
#   "mock" → uses Ethereal (fake SMTP, no real emails sent; preview URL logged to console)
#   anything else → uses the SMTP settings below to send real emails
OTP_PROVIDER=mock

# Timezone used to determine the "current day" key (IANA name)
APP_TIMEZONE=Asia/Kolkata

# ── SMTP (email delivery for OTP) ───────────────────────────
# Leave blank in development — "mock" mode uses Ethereal automatically.
# For Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# For Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# For SSL:    set SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Winter Arc ❄️" <your-email@gmail.com>
# Set to 'true' only if your mail server or local proxy/antivirus uses self-signed TLS certs
SMTP_ALLOW_SELF_SIGNED=false

# ── Client (prefix with VITE_) ───────────────────────────────
VITE_API_URL=http://localhost:5000/api
